# Carillon Recital Rota — environment variables
#
# Every value below is OPTIONAL. The server boots with these same defaults when
# no .env file exists at all, so `node server.js` on a fresh checkout works.
# A .env file at the project root is read automatically on boot.

# Port the HTTP server listens on (also honours $PORT from the process environment).
PORT=3000

# Directory holding the JSON data store. Created automatically on boot.
DATA_DIR=./data

# Optional overrides for the seeded preview accounts. Leave blank to keep the
# built-in demo login (cenius@cenius.ai / cenius) and the carillonneur accounts
# (…@carillon.test / bells123). Set real values before any deployment.
CARILLON_DEMO_EMAIL=
CARILLON_DEMO_PASSWORD=
CARILLON_SEED_PASSWORD=
